# ─────────────────────────────────────────────────────────────
#  Sahaiy — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional compatibility key name (if copying from Next.js docs)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Found in: Supabase Dashboard → Settings → API → anon/public key
# SAFE to expose client-side (RLS enforces access per user).
# ⚠️  DO NOT use service_role key here — that must stay server-side only.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional compatibility key name (if copying from Next.js docs)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_SUPABASE_ANON_KEY

# ── App ──────────────────────────────────────────────────────
# Base URL for OAuth redirect callbacks (no trailing slash).
# Development: http://localhost:5173
# Production: https://sahaiy.ai
VITE_APP_URL=http://localhost:5173

# Backend API base URL (FastAPI)
# Development: http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# App name shown in UI
VITE_APP_NAME=Sahaiy
