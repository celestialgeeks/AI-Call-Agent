# ─────────────────────────────────────────────────────────────
#  Sahaiy Backend — Environment Variables
#  Copy to sahaiy-backend/.env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Sarvam AI (TTS) ──────────────────────────────────────────
# Get your key at: https://console.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# TTS voice model (bulbul:v2 or bulbul:v3)
SARVAM_TTS_MODEL=bulbul:v2

# Default language (BCP-47): en-IN, hi-IN, ta-IN, te-IN, etc.
SARVAM_TTS_LANG=en-IN

# Default speaker when agent has no voice_name set
# Options (v2): anushka, abhilash, manisha, vidya, arjun, maya, neel, maitreyi, amartya
SARVAM_TTS_SPEAKER=anushka

# ── LLM (llama.cpp server) ───────────────────────────────────
# Run: llama-server -m models/your-model.gguf --port 8080
LLM_URL=http://localhost:8080/completion
LLM_N_PREDICT=80
LLM_TEMPERATURE=0.6

# ── STT (whisper.cpp server) ──────────────────────────────────
# Run: ./build/bin/whisper-server -m models/ggml-base.en.bin -p 8081
STT_URL=http://localhost:8081/inference
STT_TIMEOUT_SEC=5

# ── Supabase (SERVICE ROLE — server-side only) ────────────────
# Found in: Supabase Dashboard → Settings → API → service_role key
# ⚠️  NEVER expose this key client-side.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── LiveKit (optional — Phase 10) ────────────────────────────
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── App ───────────────────────────────────────────────────────
# Frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
